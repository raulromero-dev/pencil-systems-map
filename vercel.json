{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/sheet", "destination": "/index.html" },
    { "source": "/map", "destination": "/index.html" },
    { "source": "/map-2", "destination": "/index.html" },
    { "source": "/final", "destination": "/index.html" },
    { "source": "/final-2", "destination": "/index.html" },
    { "source": "/final-3", "destination": "/index.html" },
    { "source": "/descend", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/src/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
